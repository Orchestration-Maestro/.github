{
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    },
    "repository_name": {
      "exclude": [],
      "include": [
        "~ALL"
      ]
    }
  },
  "enforcement": "active",
  "name": "commits-are-conventional",
  "rules": [
    {
      "parameters": {
        "name": "Conventional commit",
        "negate": false,
        "operator": "regex",
        "pattern": "^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\\([a-z0-9._-]+\\))?!?: .{1,}"
      },
      "type": "commit_message_pattern"
    }
  ],
  "target": "branch"
}
